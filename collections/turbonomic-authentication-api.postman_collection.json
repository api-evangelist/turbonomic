          "name": "Logout from Turbonomic",
          "request": {
            "name": "Logout from Turbonomic",
            "description": {
              "content": "Invalidate the current session token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname or IP address of the Turbonomic server",
                  "type": "any",
                  "value": "{{turbonomic_host}}",
                  "key": "turbonomic_host"
                }
              ]
            },
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
